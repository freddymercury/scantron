{
  "name": "scantron",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "setup": "bun run scripts/setup.ts",
    "doctor": "bun run scripts/doctor.ts",
    "dev": "bun run scripts/dev.ts",
    "db:migrate": "bun run scripts/migrate.ts",
    "load:neighborhoods": "bun run scripts/load-neighborhoods.ts",
    "load:geocode-data": "bun run scripts/load-geocode-data.ts",
    "build:street-data": "bun run scripts/build-street-data.ts",
    "backfill": "bun run scripts/backfill.ts",
    "renormalize": "bun run scripts/renormalize.ts",
    "prune:payloads": "bun run scripts/prune-payloads.ts",
    "replay:correlation": "bun run scripts/correlate-replay.ts",
    "fixtures:correlation": "bun run scripts/build-correlation-fixtures.ts",
    "eval:correlation": "bun run scripts/eval-correlation.ts",
    "report:geocoding": "bun run scripts/geocode-report.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test",
    "lint": "bun run scripts/lint.ts",
    "check": "bun run lint && bun run typecheck && bun run test"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "@scantron/database": "workspace:*",
    "@scantron/sf-domain": "workspace:*",
    "@scantron/event-taxonomy": "workspace:*",
    "@scantron/location-normalizer": "workspace:*",
    "@scantron/observability": "workspace:*",
    "@scantron/correlation": "workspace:*"
  }
}
