# scantron — every environment variable any workspace reads.
# Copy to .env (Bun loads it automatically) and adjust. Never commit .env.

# --- web (apps/web) ---
# Port for the server-rendered web app.
WEB_PORT=3000

# Shared secret for the internal raw observation viewer (S-B4). Unset means the /internal
# route does not exist at all, which is the safe default — it shows raw source text.
INTERNAL_API_KEY=

# --- database (packages/database) ---
# SQLite file path (ADR-003). ":memory:" is used by tests.
DATABASE_URL=./data/scantron.db

# --- ingestion (services/sf-cad-ingest) ---
# DataSF host. data.sfgov.org 301-redirects here.
DATASF_HOST=https://data.sf.gov
# Optional Socrata app token. Unauthenticated requests are throttled harder.
DATASF_APP_TOKEN=
# Poll interval in seconds. The feed is a ~30-minute batch; 15s only wastes quota.
INGEST_POLL_SECONDS=60
# Per-source overrides. Fire/EMS runs ~19 h behind, so it is polled far less often.
INGEST_POLL_SECONDS_SF_POLICE_CAD=60
INGEST_POLL_SECONDS_SF_FIRE_CAD=900
INGEST_POLL_SECONDS_SF_EMS_CAD=900

# --- service observability endpoints (S-A6) ---
# Each long-running process serves /metrics and /health on its own port.
INGEST_HEALTH_PORT=3101
CORRELATOR_HEALTH_PORT=3102

# --- semantic search re-rank (optional, S-E4) ---
# Jev (TypeSafe) scores how well each search result matches the question. Unset means
# search still works, ranked lexically by FTS5 — nothing else changes.
JEV_API_KEY=
# OpenRouter's decisions endpoint (a chat/completions call is rejected — it is not a chat
# model). TypeSafe direct takes the same body at https://api.typesafe.ai/v1/systemone.
JEV_BASE_URL=https://openrouter.ai/api/alpha/decisions
# A re-rank that lands after the reader has moved on is worse than none.
JEV_TIMEOUT_MS=1200
# Tests never call the paid API: the key is stripped at test start unless this is 1.
JEV_LIVE=

# --- observability (packages/observability) ---
# debug | info | warn | error
LOG_LEVEL=info
