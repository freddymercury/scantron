# scantron — every environment variable any workspace reads.
# Copy to .env (Bun loads it automatically) and adjust. Never commit .env.

# --- web (apps/web) ---
# Port for the server-rendered web app.
WEB_PORT=3000

# --- database (packages/database) ---
# SQLite file path (ADR-003). ":memory:" is used by tests.
DATABASE_URL=./data/scantron.db

# --- ingestion (services/sf-cad-ingest) ---
# DataSF host. data.sfgov.org 301-redirects here.
DATASF_HOST=https://data.sf.gov
# Optional Socrata app token. Unauthenticated requests are throttled harder.
DATASF_APP_TOKEN=
# Poll interval in seconds. The feed is a ~30-minute batch; 15s only wastes quota.
INGEST_POLL_SECONDS=60

# --- service observability endpoints (S-A6) ---
# Each long-running process serves /metrics and /health on its own port.
INGEST_HEALTH_PORT=3101
CORRELATOR_HEALTH_PORT=3102

# --- observability (packages/observability) ---
# debug | info | warn | error
LOG_LEVEL=info
